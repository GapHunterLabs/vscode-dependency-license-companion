{
  "name": "dependency-license-companion",
  "displayName": "Dependency License Companion",
  "description": "Reads each node_modules dependency's SPDX license locally and flags copyleft/missing licenses against an allowlist -- no data leaves your editor.",
  "version": "0.1.1",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "license",    "spdx",    "compliance",    "npm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-dependency-license-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-dependency-license-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dependencyLicenseCompanion.rescan",
        "title": "Dependency License Companion: Rescan Dependencies"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
